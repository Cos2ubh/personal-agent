# Anthropic Claude API — LLM used for reasoning and tool selection.
# Get a key at https://console.anthropic.com/. Requires a small prepaid balance
# ($5 minimum). Optional CLAUDE_MODEL env var overrides the default model
# (default: claude-sonnet-4-6; alternatives: claude-opus-4-7, claude-haiku-4-5-20251001).
ANTHROPIC_API_KEY=your_anthropic_key_goes_here

# Tavily search API — free tier gives 1000 queries/month, no card required.
# Get a key at https://tavily.com/. Leave blank if you don't need web search.
TAVILY_API_KEY=your_tavily_key_goes_here

# WhatsApp bridge — required if you want to message your agent via WhatsApp.
# OWNER_NUMBER: your personal WhatsApp number, full international format, no + or spaces.
# Example: +91 98765 43210 → 919876543210
OWNER_NUMBER=919876543210

# FastAPI server URL — what the WhatsApp bridge calls when a message arrives.
# Default port 8502 (avoids clash with Streamlit on 8501).
AGENT_API_URL=http://localhost:8502

# Optional: hour (0-23, local time) at which the morning briefing is pushed to WhatsApp.
BRIEFING_HOUR=8
